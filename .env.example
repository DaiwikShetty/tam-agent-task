# Copy to .env (never commit .env). Put real keys ONLY in .env.
LLM_PROVIDER=ollama          # ollama | anthropic | openai | openai_compatible
LLM_MODEL=llama3.1:8b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- OpenAI-compatible gateway (e.g. LiteLLM) with custom headers ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://litellm-qc.zycus.net      # if you get 404, try adding /v1
# LLM_MODEL=qwen-cursor
# LLM_API_KEY=<your key>
# LLM_EXTRA_HEADERS={"product": "ta", "flowname": "djs_campus", "bundlename": "djs_campus", "x-zycus-userid": "zycus_djs", "x-zycus-tenantid": "zycus", "x-zycus-execution-mode": "manual"}

# Debugging / request limits (seconds; max retry attempts)
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=2
